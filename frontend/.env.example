# Next.js Frontend Configuration
NEXT_PUBLIC_APP_NAME="HomePulse"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Set to "true" to force client-side LocalStorage mode without calling Azure API
NEXT_PUBLIC_USE_MOCK_DATA="false"

# Azure Functions Base URL (optional, defaults to relative /api or http://localhost:7071)
NEXT_PUBLIC_API_BASE_URL=""

# Google Play Package Name (for TWA / In-App Purchases)
NEXT_PUBLIC_GOOGLE_PLAY_PACKAGE_NAME="com.homepulse.familyapp"
